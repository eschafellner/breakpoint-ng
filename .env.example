# Produktion: veröffentlichtes Image auswählen; Beispielversion zuerst erstellen.
# Anleitung: RELEASE_IMAGES.md. Kein latest verwenden.
APP_IMAGE=ghcr.io/eschafellner/breakpoint-ng:v0.1.0
# Infrastruktur separat und bewusst aktualisieren, siehe DEPLOYMENT.md.
NGINX_IMAGE=nginx:1.30.5-alpine
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.0

# Django Configuration
DJANGO_SECRET_KEY=change-me-to-a-secure-random-key-in-production
# Nur bei geplanter Schlüsselrotation: alte Schlüssel durch Kommas getrennt.
# Der Schlüssel wird auch für verschlüsselte SEPA-Daten benötigt; sicher aufbewahren.
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tc-musterdorf.at
CSRF_TRUSTED_ORIGINS=https://tc-musterdorf.at

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tennisclub
DB_USER=tennisclub
DB_PASSWORD=tennisclub_secure_password
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/1

# SMTP Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=kontakt@tc-musterdorf.at
EMAIL_HOST_PASSWORD=smtp_password
DEFAULT_FROM_EMAIL=TC Musterdorf <kontakt@tc-musterdorf.at>

# Cloudflare Tunnel
# Im Cloudflare-Dashboard die Service-URL auf http://nginx:80 setzen.
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...

# Kanonische HTTPS-Adresse für E-Mail-Links und externe Deployment-Prüfung.
# Für deploy.sh erforderlich: eigene Vereinsdomain mit https:// eintragen.
# Bei Cloudflare Access: deploy.sh --skip-public-check, danach im Browser prüfen.
PUBLIC_SITE_URL=
